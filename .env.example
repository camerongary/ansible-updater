# Ansible Update Manager Configuration

# Network range to scan for systems (CIDR notation)
# Example: 192.168.12.0/24 for your network
NETWORK_RANGE=192.168.12.0/24

# How often to run update checks (in seconds)
# Default: 3600 (1 hour)
UPDATE_INTERVAL=3600

# Require manual approval before installing updates.
#   true  (default): each cycle only CHECKS for updates; nothing is installed
#                    until you approve packages in the dashboard (port 8080).
#   false          : legacy behaviour — automatically apply all available
#                    updates on every host each cycle.
# (Reboots always require separate approval regardless of this setting.)
REQUIRE_APPROVAL=true

# Slack webhook URL for notifications
# Get this from: https://api.slack.com/messaging/webhooks
# Leave empty to disable Slack notifications
SLACK_WEBHOOK_URL=

# Bootstrap password for new hosts
# When a newly discovered host doesn't yet have the SSH key, the system will
# try to copy the key and configure passwordless sudo using this password.
# Leave empty to disable automatic bootstrapping.
BOOTSTRAP_PASSWORD=

# SSH Configuration
# Ensure you have SSH keys set up for passwordless access
# Public keys should be in ~/.ssh/authorized_keys on target systems

# Base URL of the dashboard, used in Slack "View Full Report" links.
# Set to the Docker host's address so the link works from other devices.
DASHBOARD_URL=http://192.168.12.30:8080

# Dashboard authentication. The whole dashboard requires a login (Basic Auth):
# either the admin account below, or the mandatory view-only account. Actions
# (approve, reject, reboot, recheck, scan) require the admin account. If
# DASHBOARD_PASSWORD is empty, the dashboard is viewable (as the viewer) but
# all actions are disabled. Note: Basic Auth over plain HTTP — keep this on a
# trusted LAN.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# View-only account (mandatory — cannot be disabled). VIEWER_PASSWORD is only
# the INITIAL preset used the first time the dashboard starts; once the
# password is changed from the dashboard UI ("Change viewer password"), the
# stored hash in reports/viewer_auth.json wins and this preset is ignored.
# Delete that file to reset the account back to the preset.
VIEWER_USER=viewer
VIEWER_PASSWORD=viewonly
