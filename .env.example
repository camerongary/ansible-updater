# Ansible Update Manager Configuration

# Network range to scan for systems (CIDR notation)
# Example: 192.168.12.0/24 for your network
NETWORK_RANGE=192.168.12.0/24

# How often to run update checks (in seconds)
# Default: 3600 (1 hour)
UPDATE_INTERVAL=3600

# Slack webhook URL for notifications
# Get this from: https://api.slack.com/messaging/webhooks
# Leave empty to disable Slack notifications
SLACK_WEBHOOK_URL=

# Bootstrap password for new hosts
# When a newly discovered host doesn't yet have the SSH key, the system will
# try to copy the key and configure passwordless sudo using this password.
# Leave empty to disable automatic bootstrapping.
BOOTSTRAP_PASSWORD=

# SSH Configuration
# Ensure you have SSH keys set up for passwordless access
# Public keys should be in ~/.ssh/authorized_keys on target systems
